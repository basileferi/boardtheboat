# Example configuration - the only env file tracked by git.
#
# Symfony loads this file automatically when no .env exists, so a fresh clone works as is.
# Never put a real value here: real values go in .env.local (dev machine) or in .env.local
# then `composer dump-env prod` (server). Both are git-ignored.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=dummy_change_me_in_env_local
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Dev/prod run on MariaDB. serverVersion is pinned on purpose (see docs/adr/0002).
DATABASE_URL="mysql://boardtheboat:dummy@127.0.0.1:3307/boardtheboat?serverVersion=11.4.9-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/lock ###
# Filesystem locks: the pipeline only ever runs on one host (WAMP in dev, one Infomaniak
# account in prod), so flock is enough and needs no extra service.
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/notifier ###
# Optional chat channel used only for admin failure alerts. Empty = disabled.
NOTIFIER_ADMIN_CHAT_DSN=null://null
###< symfony/notifier ###

###> boardtheboat ###
# Sender identity used by every transactional mail.
MAILER_FROM_ADDRESS=noreply@boardtheboat.example
MAILER_FROM_NAME=boardtheboat
# Address receiving admin alerts (pipeline failures, import errors).
ADMIN_ALERT_ADDRESS=admin@boardtheboat.example
# Public self-service registration. Keep 0 in production (single-client mode).
APP_REGISTRATION_OPEN=0
# Contact URL advertised in the outbound User-Agent when fetching third-party pages.
HTTP_FETCHER_CONTACT_URL=https://boardtheboat.example/about
# Shared secret guarding POST /_cron/tick on hosts without a real crontab.
# Empty value = endpoint disabled (the default, and the only safe default).
CRON_TOKEN=
# Guarded maintenance endpoints (migrations). Never leave enabled.
MAINTENANCE_ENABLED=0
# Reverse proxies whose X-Forwarded-* headers may be trusted (prod only).
# Infomaniak terminates TLS in front of PHP: set the real proxy range there.
TRUSTED_PROXIES=127.0.0.1
###< boardtheboat ###

###> france-travail ###
# https://francetravail.io - OAuth2 client credentials. Empty = source disabled.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
###< france-travail ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=dummy_change_me_in_env_local
###< lexik/jwt-authentication-bundle ###
