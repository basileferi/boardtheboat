{%- set theme = app.request.cookies.get('btb_theme') -%}
{%- set route = app.request.attributes.get('_route') ?? '' -%}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}"{% if theme in ['light', 'dark'] %} data-theme="{{ theme }}"{% endif %}>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="color-scheme" content="light dark">
        <title>{% block title %}boardtheboat{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><rect width=%2232%22 height=%2232%22 rx=%228%22 fill=%22%23141414%22/><circle cx=%2216%22 cy=%2216%22 r=%226%22 fill=%22%2300ff00%22/></svg>">
        <link rel="preload" href="{{ asset('fonts/inter-tight-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {# The import map is the only inline script we ship; it carries the request nonce. #}
            {% block importmap %}{{ importmap('app', {nonce: csp_nonce()}) }}{% endblock %}
        {% endblock %}
    </head>
    <body data-controller="sonar">
        {#
            Three permanent layers: Turbo moves them from page to page instead of rebuilding
            them, so the background keeps drifting, the curtain can close on one page and open
            on the next, and the cursor ring never jumps.
        #}
        <div id="atmosphere" class="atmosphere" data-turbo-permanent data-controller="atmosphere" aria-hidden="true">
            <span class="atmosphere__orb atmosphere__orb--a"></span>
            <span class="atmosphere__orb atmosphere__orb--b"></span>
            <span class="atmosphere__orb atmosphere__orb--c"></span>
            <span class="atmosphere__grid"></span>
            <span class="atmosphere__spot"></span>
            <span class="atmosphere__grain"></span>
        </div>

        <div id="wipe" class="wipe" data-turbo-permanent aria-hidden="true">
            <div class="wipe__panel wipe__panel--gradient"></div>
            <div class="wipe__panel wipe__panel--ink"><span class="wipe__mark">board<em>the</em>boat</span></div>
            <div class="wipe__intro"><span class="wipe__mark">board<em>the</em>boat</span><span class="wipe__bar"></span></div>
        </div>

        <div id="cursor" class="cursor" data-turbo-permanent data-controller="cursor" aria-hidden="true">
            <span class="cursor__ring"></span>
            <span class="cursor__dot"></span>
        </div>

        <a class="skip-link" href="#main">{{ 'layout.skip_to_content'|trans }}</a>

        <header class="bridge">
            <a class="bridge__brand" href="{{ path(app.user ? 'app_dashboard' : 'app_home') }}">
                <span class="bridge__signal" aria-hidden="true"></span>
                <span>board<em>the</em>boat</span>
            </a>

            <nav class="bridge__nav" aria-label="{{ 'layout.main_navigation'|trans }}">
                {% block nav %}
                    {% if app.user %}
                        {% set links = [
                            ['app_dashboard', 'dashboard', 'app_dashboard'],
                            ['app_offers', 'offers', 'app_offer'],
                            ['app_company_index', 'companies', 'app_company'],
                            ['app_recommendations', 'recommendations', 'app_recommendations'],
                            ['app_pipeline', 'pipeline', 'app_pipeline'],
                            ['app_profile', 'profile', 'app_profile'],
                        ] %}
                        {% if is_granted('ROLE_ADMIN') %}
                            {% set links = links|merge([['app_admin_dashboard', 'admin', 'app_admin']]) %}
                        {% endif %}
                        {% for link in links %}
                            <a class="nav-link" href="{{ path(link[0]) }}"{% if route starts with link[2] %} aria-current="page"{% endif %}>
                                <span class="nav-link__index" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
                                <span class="nav-link__label">{{ ('layout.nav.' ~ link[1])|trans }}</span>
                            </a>
                        {% endfor %}
                    {% else %}
                        <a class="nav-link" href="{{ path('app_login') }}"{% if route == 'app_login' %} aria-current="page"{% endif %}>
                            <span class="nav-link__label">{{ 'layout.nav.login'|trans }}</span>
                        </a>
                    {% endif %}
                {% endblock %}
            </nav>

            <div class="bridge__tools">
                <button type="button"
                        class="tool tool--sound"
                        data-sonar-target="toggle"
                        data-action="sonar#toggle"
                        data-sound-silent
                        data-label-on="{{ 'layout.sound_on'|trans }}"
                        data-label-off="{{ 'layout.sound_off'|trans }}"
                        aria-pressed="false"
                        aria-label="{{ 'layout.sound_off'|trans }}">
                    <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
                    <span class="tool__label" data-sonar-target="label">{{ 'layout.sound_off'|trans }}</span>
                </button>

                <button type="button"
                        class="tool tool--theme"
                        data-controller="theme"
                        data-action="theme#cycle"
                        data-label-system="{{ 'layout.theme.system'|trans }}"
                        data-label-dark="{{ 'layout.theme.dark'|trans }}"
                        data-label-light="{{ 'layout.theme.light'|trans }}"
                        aria-label="{{ 'layout.theme.system'|trans }}">
                    <span class="theme-dot" aria-hidden="true"></span>
                </button>

                {% set other = app.request.locale == 'en' ? 'fr' : 'en' %}
                {% if route != '' %}
                    <a class="tool tool--locale" href="{{ path(route, app.request.attributes.get('_route_params', {})|merge({_locale: other})) }}" hreflang="{{ other }}" lang="{{ other }}">
                        {{ other|upper }}
                    </a>
                {% endif %}

                {% if app.user %}
                    <form method="post" action="{{ path('app_logout') }}" class="inline-form">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button type="submit" class="tool tool--logout" aria-label="{{ 'layout.nav.logout'|trans }}" title="{{ 'layout.nav.logout'|trans }}">
                            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 4h4v16h-4M10 8l-4 4 4 4M6 12h11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                    </form>
                {% endif %}
            </div>
        </header>

        <main id="main" class="main" data-controller="reveal">
            {% block flashes %}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <p class="flash flash--{{ label }}" role="status">{{ message|trans }}</p>
                    {% endfor %}
                {% endfor %}
            {% endblock %}

            {% block body %}{% endblock %}
        </main>

        <footer class="footer">
            <div class="footer__top">
                <nav class="footer__nav" aria-label="{{ 'layout.footer_navigation'|trans }}">
                    <a href="{{ path('app_home') }}">{{ 'layout.footer.home'|trans }}</a>
                    {% if app.user %}
                        <a href="{{ path('app_dashboard') }}">{{ 'layout.nav.dashboard'|trans }}</a>
                        <a href="{{ path('app_offers') }}">{{ 'layout.nav.offers'|trans }}</a>
                    {% endif %}
                </nav>
                <p class="footer__sources">
                    {{ 'layout.footer.sources'|trans }}
                    <a href="https://www.themuse.com" rel="noopener noreferrer" target="_blank">The Muse</a> ·
                    <a href="https://himalayas.app" rel="noopener noreferrer" target="_blank">Himalayas</a> ·
                    <a href="https://www.arbeitnow.com" rel="noopener noreferrer" target="_blank">Arbeitnow</a> ·
                    <a href="https://francetravail.io" rel="noopener noreferrer" target="_blank">France Travail</a> ·
                    <a href="https://recherche-entreprises.api.gouv.fr" rel="noopener noreferrer" target="_blank">API Recherche d’entreprises</a>
                </p>
            </div>
            <p class="footer__mark" aria-hidden="true">board<em>the</em>boat</p>
        </footer>
    </body>
</html>
