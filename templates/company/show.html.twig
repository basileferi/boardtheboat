{% extends 'base.html.twig' %}

{% block title %}{{ company.name }} — boardtheboat{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <p class="eyebrow">{{ ('company.visibility.' ~ company.visibility.value)|trans }}</p>
            <h1 data-split>{{ company.name }}</h1>
            <p class="lede">
                {{ company.city ?? '' }}{% if company.city and company.sector %} · {% endif %}{{ company.sector ?? '' }}
            </p>
        </div>
        <div class="row">
            {% if is_granted('edit', company) %}
                <a class="button" href="{{ path('app_company_edit', {id: company.id}) }}">{{ 'company.action.edit'|trans }}</a>
            {% endif %}
            <form method="post" action="{{ path('app_company_save', {id: company.id}) }}" class="inline-form">
                <input type="hidden" name="_token" value="{{ csrf_token('save-company') }}">
                <button type="submit" class="button button--primary" data-action="sonar#keep">{{ 'recommendation.track'|trans }}</button>
            </form>
        </div>
    </div>

    <div class="grid-2">
        <section class="panel">
            <p class="eyebrow">{{ 'company.details'|trans }}</p>
            <table>
                <tbody>
                    <tr><th>{{ 'company.field.website'|trans }}</th><td>{% if company.website %}<a href="{{ company.website }}" target="_blank" rel="noopener noreferrer">{{ company.domain ?? company.website }}</a>{% else %}—{% endif %}</td></tr>
                    <tr><th>{{ 'company.field.career_url'|trans }}</th><td>{% if company.careerUrl %}<a href="{{ company.careerUrl }}" target="_blank" rel="noopener noreferrer">{{ 'recommendation.career_page'|trans }}</a>{% else %}—{% endif %}</td></tr>
                    <tr><th>{{ 'company.field.size'|trans }}</th><td>{{ ('company_size.' ~ company.size.value)|trans }}</td></tr>
                    <tr><th>{{ 'company.field.siren'|trans }}</th><td>{{ company.siren ?? '—' }}</td></tr>
                    <tr><th>{{ 'company.career_status'|trans }}</th><td><span class="tag">{{ ('company.career.' ~ company.careerPageStatus.value)|trans }}</span></td></tr>
                </tbody>
            </table>
        </section>

        {% if company.owner %}
            <section class="panel">
                <p class="eyebrow">{{ 'company.my_notes'|trans }}</p>
                {% if company.whyInteresting %}<p class="prose">{{ company.whyInteresting }}</p>{% endif %}
                {% if company.notes %}<p class="prose muted">{{ company.notes }}</p>{% endif %}

                {% if is_granted('edit', company) and company.visibility.value == 'private' %}
                    <form method="post" action="{{ path('app_company_suggest', {id: company.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('suggest' ~ company.id) }}">
                        <button type="submit" class="button">{{ 'company.action.suggest'|trans }}</button>
                    </form>
                {% endif %}
            </section>
        {% endif %}
    </div>

    <p class="row">
        <a class="button button--quiet" href="{{ path('app_company_index') }}">{{ 'company.action.back'|trans }}</a>
        {% if is_granted('delete', company) %}
            {{ include('company/_delete_form.html.twig') }}
        {% endif %}
    </p>
{% endblock %}
