{% extends 'base.html.twig' %}

{% block title %}{{ 'pipeline.title'|trans }} — boardtheboat{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <p class="eyebrow">{{ 'pipeline.eyebrow'|trans }}</p>
            <h1 data-split>{{ 'pipeline.title'|trans }}</h1>
            <p class="lede">{{ 'pipeline.lede'|trans }}</p>
        </div>
    </div>

    {% if due is not empty %}
        <section class="panel panel--signal" data-reveal>
            <p class="eyebrow">{{ 'pipeline.due_title'|trans }}</p>
            <ul class="plain-list stack">
                {% for application in due %}
                    <li class="row spread">
                        <span>{{ application.company.name }}</span>
                        <span class="tag tag--brass">
                            {{ 'pipeline.due_since'|trans }} {{ application.followUpAt|format_date(pattern='d MMMM') }}
                        </span>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <div class="grid-2">
        {% for status, applications in board %}
            <section class="panel" data-reveal>
                <p class="eyebrow">
                    {{ ('pipeline_status.' ~ status)|trans }}
                    <span class="sounding__figure">{{ counts[status] }}</span>
                </p>

                {% if applications is empty %}
                    <p class="muted">{{ 'pipeline.empty_column'|trans }}</p>
                {% else %}
                    <ul class="plain-list stack">
                        {% for application in applications %}
                            <li class="panel panel--sunk">
                                <strong>{{ application.company.name }}</strong>
                                {% if application.targetRole %}<p class="muted">{{ application.targetRole }}</p>{% endif %}

                                <form method="post" action="{{ path('app_application_status', {id: application.id}) }}" class="row">
                                    <input type="hidden" name="_token" value="{{ csrf_token('application-status') }}">
                                    <label class="visually-hidden" for="status-{{ application.id }}">{{ 'pipeline.change_status'|trans }}</label>
                                    <select id="status-{{ application.id }}" name="status">
                                        {% for case in pipeline_statuses %}
                                            <option value="{{ case }}" {{ case == status ? 'selected' : '' }}>
                                                {{ ('pipeline_status.' ~ case)|trans }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                    <button type="submit" class="button">{{ 'pipeline.apply_status'|trans }}</button>
                                </form>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>
        {% endfor %}
    </div>
{% endblock %}
